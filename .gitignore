# ============================================================
#  .gitignore —— 写在这里的东西，永远不会被传到 GitHub
#
#  每行一条规则，语法很简单：
#      素材/           忽略「素材」这个文件夹（整个）
#      *.docx          忽略所有 .docx 文件
#      我的笔记.txt    忽略这一个文件
#      !重要.txt       例外：不忽略它（感叹号 = 反悔）
#
#  想临时上传一个被忽略的文件：git add -f "文件名"
#  想知道某文件为什么被忽略：git check-ignore -v "文件名"
# ============================================================


# ------------------------------------------------------------
#  一、隐私保护（最重要的部分，别删）
# ------------------------------------------------------------

# 数据目录：素材、稿件、数据库全部在这里，整个不传
# 只留一个 .gitkeep 让空文件夹能保留下来
data/*
!data/.gitkeep

# 文档 / 稿件类文件，一律不传
*.docx
*.doc
*.pdf
*.epub
*.mobi
*.wps
*.xlsx
*.xls
*.csv
*.rtf

# 密钥、凭据、证书，一律不传
.env
*.pem
*.key
*.p12
*.pfx

# 按目录名兜底（万一你把稿子放在了项目里）
素材/
稿件/
小说/
大纲/
细纲/
人设/
剧情/
设定/

# 个人文件
我的敏感词.txt
我的笔记.txt


# ------------------------------------------------------------
#  二、体积与运行环境（不是隐私，但也不该传）
# ------------------------------------------------------------

# 虚拟环境不要传（体积大，别人自己装就行）
.venv/
venv/
env/

# Python 运行缓存
__pycache__/
*.pyc
*.pyo


# ------------------------------------------------------------
#  三、编辑器与系统生成的文件
# ------------------------------------------------------------

.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store
desktop.ini

# 旧版本备份（git 本身就能回退历史，不需要重复存）
*备份*
_v*_tmp.*
*.bak
*.tmp
